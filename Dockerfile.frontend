FROM node:20-alpine AS build

WORKDIR /app

COPY Frontend/package*.json ./

RUN npm ci

COPY Frontend/ ./

ARG VITE_LOCALHOST
ARG VITE_SERVER_URL

ENV VITE_LOCALHOST=$VITE_LOCALHOST
ENV VITE_SERVER_URL=$VITE_SERVER_URL

RUN npm run build


FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]